generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USUÁRIOS DO SISTEMA (ADMINISTRADOR & PROFESSORES)
// ==========================================
model Usuario {
  id                  String   @id @default(uuid())
  nome                String
  email               String   @unique
  cpf                 String?  @unique
  senha               String
  cargo               String   @default("PROFESSOR") // Valores: "ADMIN" ou "PROFESSOR"
  telefone            String?
  modalidade          String   @default("Muay Thai") // "Muay Thai", "Jiu-Jitsu", "Boxe", "MMA", "Taekwondo"
  graduacao           String?  @default("Prajied Azul Escuro e Preto") // Faixa / Prajied
  tempoPratica        String?  // Tempo de prática/treino (Ex: "10 anos de prática")
  tempoDocencia       String?  // Tempo lecionando / dando aulas (Ex: "6 anos ministrando aulas")
  tempoAula           String?  @default("60 min") // Duração padrão da aula (Ex: "60 min", "90 min")
  horariosAula        String?  // Horários / Grade de aulas (Ex: "Seg, Qua e Sex - 19:00")
  cargaHorariaSemanal String?  // Carga horária semanal (Ex: "6h semanais")
  prajied             String?  @default("Prajied Azul Escuro e Preto") // Mantido para compatibilidade
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
}

// ==========================================
// ALUNOS & MATRÍCULAS
// ==========================================
model Aluno {
  id             String        @id @default(uuid())
  nome           String
  email          String?       @unique
  telefone       String?
  cpf            String?       @unique
  senha          String?       // Senha de acesso
  primeiroAcesso Boolean       @default(true) // Obriga a redefinir no 1º acesso
  plano          String?       // Valores: DIARIA, 2x na semana, 3x na semana, Todos os Horários
  modalidade     String?       @default("Muay Thai") // Muay Thai, Jiu-Jitsu, Boxe, MMA, Taekwondo
  graduacao      String?       @default("Branco") // Faixa ou Prajied ou Nível
  prajied        String        @default("Branco") // Graduação do Muay Thai (retrocompatibilidade)
  criadoEm       DateTime      @default(now())
  
  mensalidades        Mensalidade[]
  presencas           AgendamentoPresenca[]
  conquistasProgresso UserAchievementProgress[]
}

model Mensalidade {
  id             String          @id @default(uuid())
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String          @default("PENDENTE") // Valores: PENDENTE, PAGO, ATRASADO
  
  alunoId        String
  aluno          Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  criadoEm       DateTime        @default(now())
}

// ==========================================
// AGENDA, AULAS & FREQUÊNCIA DETALHADA
// ==========================================
model EventoDeAula {
  id          String                @id @default(uuid())
  titulo      String
  dataInicio  DateTime
  dataFim     DateTime
  
  agendamentos AgendamentoPresenca[]
  
  criadoEm    DateTime              @default(now())
}

model AgendamentoPresenca {
  id                 String        @id @default(uuid())
  // Status: AGENDADO, PRESENTE, FALTA (AUSENTE), DOENCA (FALTA_DOENCA), JUSTIFICADO
  status             String        @default("AGENDADO")
  fotoComprovanteUrl String?

  alunoId            String
  aluno              Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  
  eventoId           String?
  evento             EventoDeAula? @relation(fields: [eventoId], references: [id])
  
  data               DateTime      @default(now())
  justificativa      String?       // Detalhe ou atestado
  tipoJustificativa  String?       // DOENCA, ATESTADO, TRABALHO, PESSOAL, OUTRO

  // Campos de Gamificação ("Trilha do Nak Muay")
  shift                   String?  // MANHA, TARDE, NOITE
  is_special_event        Boolean  @default(false)
  accompanied_by_user_id  String?
  checked_by_teacher_id   String?
  arrived_early           Boolean  @default(false)
  adverse_weather         Boolean  @default(false)

  criadoEm           DateTime      @default(now())
}

model AgendamentoExperimental {
  id            String    @id @default(uuid())
  nome          String
  telefone      String
  data          String
  horario       String
  status        String    @default("PENDENTE") // PENDENTE, REALIZADA, FECHOU_CONTRATO, DESISTIU
  dataRealizada DateTime?
  observacao    String?
  criadoEm      DateTime  @default(now())
}

// ==========================================
// MURAL DE AVISOS (PROFESSORES & ADMIN)
// ==========================================
model Aviso {
  id          String   @id @default(uuid())
  titulo      String
  conteudo    String
  tipo        String   @default("GERAL") // GERAL, URGENTE, GRADUACAO, EVENTO
  autorNome   String   @default("Felipe Borü")
  autorCargo  String   @default("Professor") // "Administrador" ou "Professor"
  fixado      Boolean  @default(false)
  criadoEm    DateTime @default(now())
}

// ==========================================
// LOJA & MERCADO BORÜ (BETA)
// ==========================================
model Produto {
  id          String   @id @default(uuid())
  nome        String
  categoria   String   // PROTETOR_BUCAL, LUVAS, CANELEIRAS, BANDAGENS, ALIMENTOS
  preco       Float
  estoque     Int      @default(0)
  descricao   String?
  imagemUrl   String?
  disponivel  Boolean  @default(true)
  criadoEm    DateTime @default(now())
}

// ==========================================
// MÓDULO DE GAMIFICAÇÃO ("TRILHA DO NAK MUAY")
// ==========================================
model GamificationRank {
  id                    String   @id @default(uuid())
  name                  String
  required_checkins_min Int
  required_checkins_max Int?     // Null representa 250+ (sem limite superior)
  badge_icon_url        String   @default("🥊")
  reward_description    String?
  order_index           Int      @default(1)
  is_active             Boolean  @default(true)
  criadoEm              DateTime @default(now())
}

model GamificationAchievement {
  id             String                    @id @default(uuid())
  title          String
  description    String
  category       String                    // FREQUENCIA, STREAKS, HORARIOS, SUPERACAO, COMUNIDADE
  badge_icon_url String                    @default("🏅")
  trigger_type   String                    // Ex: TOTAL_CHECKINS, WEEKLY_CHECKINS, MONTHLY_CHECKINS, STREAK_WEEKS, SHIFT_CHECKINS, etc.
  trigger_value  String                    @default("{}") // JSON flexível com parâmetros do gatilho
  xp_points      Int                       @default(50)
  reward_text    String?
  is_secret      Boolean                   @default(false)
  is_active      Boolean                   @default(true)
  criadoEm       DateTime                  @default(now())

  progressos     UserAchievementProgress[]
}

model UserAchievementProgress {
  id               String                  @id @default(uuid())
  user_id          String
  aluno            Aluno                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement_id   String
  achievement      GamificationAchievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  current_progress Int                     @default(0)
  target_progress  Int                     @default(1)
  unlocked_at      DateTime?
  status           String                  @default("locked") // locked, in_progress, completed
  notified         Boolean                 @default(false)
  atualizadoEm     DateTime                @updatedAt

  @@unique([user_id, achievement_id])
}
