generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Aluno {
  id             String        @id @default(uuid())
  nome           String
  email          String?       @unique
  telefone       String?
  cpf            String?       @unique
  senha          String?       // Senha criptografada (ou temporária)
  primeiroAcesso Boolean       @default(true) // Controla se o aluno precisa trocar a senha
  plano          String?       // Valores: DIARIA, 2x na semana, 3x na semana, Todos os Horários
  prajied        String        @default("Branco") // Nível/Graduação do aluno
  criadoEm       DateTime      @default(now())
  
  mensalidades   Mensalidade[]
  presencas      AgendamentoPresenca[]
}

model Mensalidade {
  id             String          @id @default(uuid())
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String          @default("PENDENTE") // Valores: PENDENTE, PAGO, ATRASADO
  
  alunoId        String
  aluno          Aluno           @relation(fields: [alunoId], references: [id])
  
  criadoEm       DateTime        @default(now())
}

model EventoDeAula {
  id          String                @id @default(uuid())
  titulo      String
  dataInicio  DateTime
  dataFim     DateTime
  
  agendamentos AgendamentoPresenca[]
  
  criadoEm    DateTime              @default(now())
}

model AgendamentoPresenca {
  id                 String        @id @default(uuid())
  status             String        @default("AGENDADO") // Valores: AGENDADO, PRESENTE, AUSENTE, JUSTIFICADO
  fotoComprovanteUrl String?

  alunoId            String
  aluno              Aluno         @relation(fields: [alunoId], references: [id])
  
  eventoId           String?
  evento             EventoDeAula? @relation(fields: [eventoId], references: [id])
  
  data               DateTime      @default(now())
  justificativa      String?

  criadoEm           DateTime      @default(now())
}

model AgendamentoExperimental {
  id            String    @id @default(uuid())
  nome          String
  telefone      String
  data          String
  horario       String
  status        String    @default("PENDENTE") // PENDENTE, REALIZADA, FECHOU_CONTRATO, DESISTIU
  dataRealizada DateTime?
  observacao    String?
  criadoEm      DateTime  @default(now())
}
