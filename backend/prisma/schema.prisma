generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USUÁRIOS DO SISTEMA (ADMINISTRADOR & PROFESSORES)
// ==========================================
model Usuario {
  id                  String   @id @default(uuid())
  nome                String
  email               String   @unique
  cpf                 String?  @unique
  senha               String
  cargo               String   @default("PROFESSOR") // Valores: "ADMIN" ou "PROFESSOR"
  telefone            String?
  modalidade          String   @default("Muay Thai") // "Muay Thai", "Jiu-Jitsu", "Boxe", "MMA", "Taekwondo"
  graduacao           String?  @default("Prajied Azul Escuro e Preto") // Faixa / Prajied
  tempoPratica        String?  // Tempo de prática/treino (Ex: "10 anos de prática")
  tempoDocencia       String?  // Tempo lecionando / dando aulas (Ex: "6 anos ministrando aulas")
  tempoAula           String?  @default("60 min") // Duração padrão da aula (Ex: "60 min", "90 min")
  horariosAula        String?  // Horários / Grade de aulas (Ex: "Seg, Qua e Sex - 19:00")
  cargaHorariaSemanal String?  // Carga horária semanal (Ex: "6h semanais")
  prajied             String?  @default("Prajied Azul Escuro e Preto") // Mantido para compatibilidade
  fotoPerfilUrl       String?  // Upload de arquivo local/storage da Foto de Perfil do Professor (Módulo 1)
  horarios_aula       String?  // Array/JSON ou relação de horários de aula visível no agendamento do aluno (Módulo 1)
  prajied_faixa       String?  // Graduação/Faixa padronizada do Professor (Módulo 1)
  is_dev              Boolean  @default(false) // Flag AdminDev / BrgAdmin (Ítalo Bergamin - Módulo 1)
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
}

// ==========================================
// ALUNOS & MATRÍCULAS
// ==========================================
model Aluno {
  id                         String    @id @default(uuid())
  nome                       String
  email                      String?   @unique
  telefone                   String?
  cpf                        String?   @unique
  senha                      String?   // Senha de acesso
  primeiroAcesso             Boolean   @default(true) // Obriga a redefinir no 1º acesso
  plano                      String?   // Valores: DIARIA, 2x na semana, 3x na semana, Todos os Horários
  modalidade                 String?   @default("Muay Thai") // Muay Thai, Jiu-Jitsu, Boxe, MMA, Taekwondo
  graduacao                  String?   @default("Branco") // Faixa ou Prajied ou Nível
  prajied                    String    @default("Branco") // Graduação do Muay Thai (retrocompatibilidade)
  is_bolsista                Boolean   @default(false) // Flag booleana Aluno Bolsista - ignora inadimplência e faturas automáticas (Módulo 1)
  has_signed_contract        Boolean   @default(false) // Middleware de bloqueio de contrato eletrônico (Módulo 2)
  data_de_adesao             DateTime? // Data de adesão para fixar dia de vencimento financeiro (Módulo 2)
  contract_signed_at         DateTime? // Timestamp da assinatura eletrônica (Módulo 2)
  contract_signature_payload String?   // Payload JSON de auditoria (Nome, CPF, Timestamp) (Módulo 2)
  total_xp                   Int       @default(0) // Experiência cumulativa vitalícia (define nível e patente)
  spendable_points           Int       @default(0) // Moeda virtual para resgate na Loja In-App
  criadoEm                   DateTime  @default(now())

  mensalidades        Mensalidade[]
  presencas           AgendamentoPresenca[]
  conquistasProgresso UserAchievementProgress[]
  extratoPontos       PointsLedger[]
  resgatesLoja        RewardRedemption[]
  historicoGraduacoes GraduationHistory[]
  contratosLongos     StudentContract[]
}

model Mensalidade {
  id             String    @id @default(uuid())
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String    @default("PENDENTE") // Valores: PENDENTE, PAGO, ATRASADO

  alunoId        String
  aluno          Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  criadoEm       DateTime  @default(now())
}

// ==========================================
// AGENDA, AULAS & FREQUÊNCIA DETALHADA
// ==========================================
model EventoDeAula {
  id          String                @id @default(uuid())
  titulo      String
  dataInicio  DateTime
  dataFim             DateTime
  cancelada           Boolean               @default(false)
  motivoCancelamento  String?
  professorId         String?
  professorNome       String?               @default("Felipe Borü")
  modalidade          String?               @default("Muay Thai")
  capacidade          Int                   @default(25)

  agendamentos AgendamentoPresenca[]

  criadoEm    DateTime              @default(now())
}

model AgendamentoPresenca {
  id                 String        @id @default(uuid())
  // Status: AGENDADO, PRESENTE, FALTA (AUSENTE), DOENCA (FALTA_DOENCA), JUSTIFICADO
  status             String        @default("AGENDADO")
  fotoComprovanteUrl String?

  alunoId            String
  aluno              Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  eventoId           String?
  evento             EventoDeAula? @relation(fields: [eventoId], references: [id])

  data               DateTime      @default(now())
  justificativa      String?       // Detalhe ou atestado
  tipoJustificativa  String?       // DOENCA, ATESTADO, TRABALHO, PESSOAL, OUTRO

  // Campos de Gamificação ("Trilha do Nak Muay")
  shift                   String?  // MANHA, TARDE, NOITE
  is_special_event        Boolean  @default(false)
  accompanied_by_user_id  String?
  checked_by_teacher_id   String?
  arrived_early           Boolean  @default(false)
  adverse_weather         Boolean  @default(false)

  criadoEm           DateTime      @default(now())
}

model AgendamentoExperimental {
  id            String    @id @default(uuid())
  nome          String
  telefone      String
  data          String
  horario       String
  professorNome String?   @default("Felipe Borü")
  status        String    @default("PENDENTE") // PENDENTE, REALIZADA, FECHOU_CONTRATO, DESISTIU
  dataRealizada DateTime?
  observacao    String?
  criadoEm      DateTime  @default(now())
}

// ==========================================
// MÓDULO 1: DEV DASHBOARD - LOGS & MONITORAMENTO
// ==========================================
model SystemLog {
  id       String   @id @default(uuid())
  level    String   @default("INFO") // INFO, WARN, ERROR, WEBHOOK
  service  String   @default("API")
  message  String
  metadata String?
  criadoEm DateTime @default(now())
}

// ==========================================
// MURAL DE AVISOS (PROFESSORES & ADMIN)
// ==========================================
model Aviso {
  id          String   @id @default(uuid())
  titulo      String
  conteudo    String
  tipo        String   @default("GERAL") // GERAL, URGENTE, GRADUACAO, EVENTO
  autorNome   String   @default("Felipe Borü")
  autorCargo  String   @default("Professor") // "Administrador" ou "Professor"
  fixado      Boolean  @default(false)
  criadoEm    DateTime @default(now())
}

// ==========================================
// LOJA & MERCADO BORÜ (BETA)
// ==========================================
model Produto {
  id          String   @id @default(uuid())
  nome        String
  categoria   String   // PROTETOR_BUCAL, LUVAS, CANELEIRAS, BANDAGENS, ALIMENTOS
  preco       Float
  estoque     Int      @default(0)
  descricao   String?
  imagemUrl   String?
  disponivel  Boolean  @default(true)
  criadoEm    DateTime @default(now())
}

// ==========================================
// MÓDULO DE GAMIFICAÇÃO ("TRILHA DO NAK MUAY")
// ==========================================
model GamificationRank {
  id                    String   @id @default(uuid())
  name                  String
  required_checkins_min Int
  required_checkins_max Int?     // Null representa 250+ (sem limite superior)
  badge_icon_url        String   @default("🥊")
  reward_description    String?
  order_index           Int      @default(1)
  is_active             Boolean  @default(true)
  criadoEm              DateTime @default(now())
}

model GamificationAchievement {
  id             String                    @id @default(uuid())
  title          String
  description    String
  category       String                    // FREQUENCIA, STREAKS, HORARIOS, SUPERACAO, COMUNIDADE
  badge_icon_url String                    @default("🏅")
  trigger_type   String                    // Ex: TOTAL_CHECKINS, WEEKLY_CHECKINS, MONTHLY_CHECKINS, STREAK_WEEKS, SHIFT_CHECKINS, etc.
  trigger_value  String                    @default("{}") // JSON flexível com parâmetros do gatilho
  xp_points      Int                       @default(50)
  reward_text    String?
  is_secret      Boolean                   @default(false)
  is_active      Boolean                   @default(true)
  criadoEm       DateTime                  @default(now())

  progressos     UserAchievementProgress[]
}

model UserAchievementProgress {
  id               String                  @id @default(uuid())
  user_id          String
  aluno            Aluno                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement_id   String
  achievement      GamificationAchievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  current_progress Int                     @default(0)
  target_progress  Int                     @default(1)
  unlocked_at      DateTime?
  status           String                  @default("locked") // locked, in_progress, completed
  notified         Boolean                 @default(false)
  atualizadoEm     DateTime                @updatedAt

  @@unique([user_id, achievement_id])
}

// ==========================================
// MÓDULO ERP FINANCEIRO COMPLETO (ENTRADAS, MERCADO, ASSINATURAS E GASTOS)
// ==========================================
model TransacaoFinanceira {
  id              String   @id @default(uuid())
  tipo            String   @default("ENTRADA") // "ENTRADA" | "SAIDA"
  categoria       String   @default("MENSALIDADE") // MENSALIDADE, MERCADO_LOJA, DIARIA_AVULSA, WELLHUB_TOTALPASS, EXAME_GRADUACAO, EVENTO_SEMINARIO, OUTROS_ENTRADA | ALUGUEL_CONTAS, EQUIPAMENTOS_MANUTENCAO, ESTOQUE_MERCADO, PAGAMENTO_PROFESSORES, MARKETING_SISTEMA, IMPOSTOS_TAXAS, OUTROS_GASTOS
  descricao       String
  valor           Float
  data            DateTime @default(now())
  metodoPagamento String   @default("PIX") // PIX, DINHEIRO, CARTAO_CREDITO, CARTAO_DEBITO, BOLETO_TRANSFERENCIA, CONVENIO
  status          String   @default("CONFIRMADO") // CONFIRMADO, PENDENTE, CANCELADO
  alunoId         String?
  alunoNome       String?
  produtoId       String?
  produtoNome     String?
  quantidade      Int?     @default(1)
  registradoPor   String?  @default("Administração")
  observacao      String?
  criadoEm        DateTime @default(now())
}



// ==========================================
// MÓDULO DE ECONOMIA GAMIFICADA (POINTS & RECOMPENSAS)
// ==========================================
model PointsLedger {
  id                 String   @id @default(uuid())
  alunoId            String
  aluno              Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  tipo               String   // PRESENCA_TATAME, STREAK_SEMANAL, CONQUISTA_DESBLOQUEADA, RESGATE_LOJA, BONUS_CONTRATO, AJUSTE_ADMIN
  xp_delta           Int      @default(0)
  points_delta       Int      @default(0)
  saldo_pontos_apos  Int
  descricao          String
  referenciaId       String?
  criadoEm           DateTime @default(now())
}

model RewardStoreItem {
  id                 String             @id @default(uuid())
  nome               String
  categoria          String             // ACESSORIOS, EQUIPAMENTOS, VESTUARIO
  custo_points       Int
  estoque            Int                @default(10)
  descricao          String?
  imagem_url         String?
  ativo              Boolean            @default(true)
  criadoEm           DateTime           @default(now())

  resgates           RewardRedemption[]
}

model RewardRedemption {
  id                 String          @id @default(uuid())
  alunoId            String
  aluno              Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  itemId             String
  item               RewardStoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pontos_gastos      Int
  codigo_voucher     String          @unique
  status             String          @default("PENDENTE_RETIRADA") // PENDENTE_RETIRADA, ENTREGUE, CANCELADO
  entregueEm         DateTime?
  entreguePor        String?
  criadoEm           DateTime        @default(now())
}

model GraduationHistory {
  id                 String   @id @default(uuid())
  alunoId            String
  aluno              Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  modalidade         String   @default("Muay Thai")
  graduacao_anterior String?
  nova_graduacao     String
  professorId        String?
  professorNome      String?
  data_graduacao     DateTime @default(now())
  notas_exame        String?
  certificado_url    String?
  criadoEm           DateTime @default(now())
}

// ==========================================
// MÓDULO DE FECHAMENTO DE CAIXA DIÁRIO OBRIGATÓRIO
// ==========================================
model CashRegisterSession {
  id                       String    @id @default(uuid())
  data_abertura            DateTime  @default(now())
  data_fechamento          DateTime?
  operador_abertura_id     String?
  operador_abertura_nome   String?
  operador_fechamento_id   String?
  operador_fechamento_nome String?
  saldo_inicial_dinheiro   Float     @default(0)
  entradas_dinheiro        Float     @default(0)
  entradas_pix             Float     @default(0)
  entradas_cartao          Float     @default(0)
  saidas_dinheiro          Float     @default(0)
  saldo_dinheiro_esperado  Float     @default(0)
  saldo_dinheiro_contado   Float?
  diferenca_dinheiro       Float?
  justificativa_diferenca  String?
  status                   String    @default("ABERTO") // ABERTO, FECHADO
  resumo_json              String?
  criadoEm                 DateTime  @default(now())
}

// ==========================================
// GESTÃO DE CONTRATOS LONGOS (3M, 6M, 1 ANO)
// ==========================================
model StudentContract {
  id                       String   @id @default(uuid())
  alunoId                  String
  aluno                    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  nome_plano               String   // Trimestral, Semestral, Anual
  tipo_duracao             String   // TRIMESTRAL, SEMESTRAL, ANUAL
  duracao_meses            Int      @default(3)
  valor_total              Float
  valor_mensal_competencia Float
  data_inicio              DateTime @default(now())
  data_fim                 DateTime
  status                   String   @default("ATIVO") // ATIVO, CONCLUIDO, CANCELADO
  observacao               String?
  criadoEm                 DateTime @default(now())
}

// ==========================================
// COMISSIONAMENTO DINÂMICO DE PROFESSORES
// ==========================================
model TeacherCommissionSetting {
  id                   String   @id @default(uuid())
  professorId          String   @unique
  modelo               String   @default("POR_ALUNO_PRESENTE") // POR_ALUNO_PRESENTE, POR_MATRICULADO_ATIVO, HIBRIDO
  valor_por_presenca   Float    @default(3.0)
  valor_por_matriculado Float   @default(5.0)
  bonus_conversao_lead Float    @default(30.0)
  criadoEm             DateTime @default(now())
}

model TeacherCommissionReport {
  id                           String   @id @default(uuid())
  professorId                  String
  professorNome                String
  mes                          Int
  ano                          Int
  aulas_ministradas            Int      @default(0)
  total_presencas              Int      @default(0)
  total_matriculados           Int      @default(0)
  total_conversoes             Int      @default(0)
  valor_comissao_presenca      Float    @default(0)
  valor_comissao_matriculados  Float    @default(0)
  valor_bonus_conversoes       Float    @default(0)
  valor_total                  Float    @default(0)
  status                       String   @default("PENDENTE") // PENDENTE, PAGO
  pagoEm                       DateTime?
  criadoEm                     DateTime @default(now())

  @@unique([professorId, mes, ano])
}

// ==========================================
// BORÜ IA AUTÔNOMA — INTELLIGENT OPERATIONS
// ==========================================

model AiAutomationConfig {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(false) // Controle central ON/OFF (ATIVAR IA / DESATIVAR IA)
  mode                     String   @default("IA_AUTONOMA") // "IA_AUTONOMA" | "IA_ASSISTIDA" | "MODO_MANUAL"
  whatsappConnected        Boolean  @default(false)
  whatsappProvider         String   @default("CLOUD_API") // "CLOUD_API" | "OFFICIAL_BSP"
  whatsappPhoneNumber      String   @default("(69) 99238-4491")
  whatsappPhoneNumberId    String?
  whatsappBusinessAccountId String?
  whatsappVerifyToken      String   @default("boru_ia_webhook_verify_2026")
  businessHoursOnlyFollowUp Boolean @default(true)
  followUpStartHour        Int      @default(8)
  followUpEndHour          Int      @default(20)
  maxFollowUpsPerContact   Int      @default(3)
  minHoursBetweenFollowUps Int      @default(24)
  pixChaveOficial          String   @default("borucentrodecombate@gmail.com")
  pixFavorecido            String   @default("BORÜ Centro de Combate")
  linkPagamentoOficial     String   @default("https://www.borucentrodecombate.com/portal")
  enderecoOficial          String   @default("Porto Velho - RO (Coordenadas GPS: -8.762142, -63.869645) — Estrutura 180m² 100% Climatizada")
  instagramOficial         String   @default("@borucentrodecombate")
  customSettingsJson       String?  // JSON com templates de mensagens editáveis, prazos customizados e instruções gerais da IA
  updatedBy                String?  @default("Sistema")
  updatedAt                DateTime @updatedAt
  criadoEm                 DateTime @default(now())
}

model WhatsAppConversation {
  id                      String   @id @default(uuid())
  telefone                String   @unique // Telefone normalizado (ex: 5569992384491)
  telefoneExibicao        String?  // Ex: (69) 99238-4491
  nomeContato             String   @default("Visitante WhatsApp")
  tipoContato             String   @default("LEAD") // "ALUNO" | "EX_ALUNO" | "LEAD" | "RESPONSAVEL"
  alunoId                 String?  // Vínculo com Aluno cadastrado
  experimentalId          String?  // Vínculo com AgendamentoExperimental (CRM)
  statusAtendimento       String   @default("IA_ATIVA") // "IA_ATIVA" | "PAUSADA_HUMANO" | "AGUARDANDO_APROVACAO" | "TRANSFERIDA_HUMANO" | "ENCERRADA"
  iaPausadaIndividual     Boolean  @default(false) // Pausa individual por conversa
  etapaFunil              String   @default("RECEPCAO") // "RECEPCAO" | "QUALIFICACAO" | "APRESENTACAO_PLANOS" | "AGENDAMENTO_EXPERIMENTAL" | "EXPERIMENTAL_AGENDADA" | "POS_EXPERIMENTAL" | "MATRICULADO" | "SUPORTE_ALUNO" | "FINANCEIRO"
  objetivoTreino          String?  // Ex: Condicionamento, Defesa Pessoal, Emagrecimento, Competição, Kids
  modalidadeInteresse     String?  @default("Muay Thai")
  experienciaPrevia       String?  // Ex: Iniciante zero, Já treinou
  disponibilidadeHorario  String?  // Ex: Noite 19h, Tarde 16h
  ultimaIntencao          String?  // Ex: DUVIDA_PRECO, AGENDAR_EXPERIMENTAL, CONSULTA_MENSALIDADE, CANCELAMENTO
  resumoMemoriaContexto   String?  // Memória contextual acumulativa da conversa
  motivoTransferencia     String?  // Preenchido quando transferido para humano
  dossieTransferenciaJson String?  // JSON completo com Nome, Telefone, Histórico, Motivo, Coletados, Ações e Recomendação
  atendenteHumanoNome     String?
  optOutFollowUp          Boolean  @default(false) // Respeito a opt-out (PARAR / SAIR)
  naoLidasAdmin           Int      @default(0)
  ultimaMensagemTexto     String?
  ultimaMensagemEm        DateTime @default(now())
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  mensagens               WhatsAppMessage[]
  operacoes               AiOperationAuditLog[]
  followUps               AiFollowUpTask[]
  tickets                 AiServiceTicket[]
}

model WhatsAppMessage {
  id                  String               @id @default(uuid())
  conversationId      String
  conversation        WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalMessageId   String?              @unique // ID da mensagem na WhatsApp Cloud API (controle de duplicidade)
  direcao             String               @default("INBOUND") // "INBOUND" | "OUTBOUND"
  remetente           String               @default("CONTATO") // "CONTATO" | "IA" | "HUMANO" | "SISTEMA"
  remetenteNome       String?
  tipoMidia           String               @default("TEXT") // "TEXT" | "AUDIO" | "IMAGE" | "DOCUMENT" | "TEMPLATE"
  conteudo            String
  transcricaoAudio    String?
  statusEnvio         String               @default("SENT") // "RECEIVED" | "PENDING_APPROVAL" | "APPROVED_SENT" | "REJECTED" | "SENT" | "DELIVERED" | "READ" | "FAILED"
  intencaoDetectada   String?
  toolsAcionadasJson  String?              // Lista de tools executadas pela IA para esta resposta
  tempoRespostaMs     Int?
  erroDetalhe         String?
  criadoEm            DateTime             @default(now())
}

model AiOperationAuditLog {
  id               String                @id @default(uuid())
  conversationId   String?
  conversation     WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolName         String                // Ex: consultar_aluno, agendar_aula_experimental, Toggle_IA_Status
  categoria        String                @default("TOOL_EXECUTION") // "STATE_CHANGE" | "TOOL_EXECUTION" | "WEBHOOK" | "FOLLOW_UP" | "HANDOFF" | "SECURITY_GUARD"
  inputPayload     String?
  outputResult     String?
  sucesso          Boolean               @default(true)
  autorizado       Boolean               @default(true)
  executadoPor     String                @default("BORU_IA") // "BORU_IA" | Nome do Admin
  criadoEm         DateTime              @default(now())
}

model AiFollowUpTask {
  id               String               @id @default(uuid())
  conversationId   String
  conversation     WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tipoGatilho      String               // "LEAD_PRECO_SUMIU" | "INTERESSE_EXPERIMENTAL" | "LEMBRETE_EXPERIMENTAL" | "FALTOU_EXPERIMENTAL" | "POS_EXPERIMENTAL_NAO_MATRICULOU" | "ALUNO_SUMIDO_TREINO" | "MENSALIDADE_PROXIMA_VENCIMENTO" | "MENSALIDADE_PENDENTE"
  descricaoMotivo  String
  agendadoPara     DateTime
  status           String               @default("PENDENTE") // "PENDENTE" | "ENVIADO" | "CANCELADO" | "FALHOU" | "BLOQUEADO_IA_OFF"
  tentativa        Int                  @default(1)
  mensagemSugerida String?
  mensagemEnviada  String?
  executadoEm      DateTime?
  erroDetalhe      String?
  criadoEm         DateTime             @default(now())
}

model AiServiceTicket {
  id                  String                @id @default(uuid())
  protocolo           String                @unique
  conversationId      String?
  conversation        WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  alunoId             String?
  nomeContato         String
  telefone            String
  tipoSolicitacao     String                // "CANCELAMENTO" | "PAUSA_PLANO" | "ALTERACAO_PLANO" | "NEGOCIACAO_FINANCEIRA" | "DIVERGENCIA_FINANCEIRA" | "PROBLEMA_ADMINISTRATIVO" | "SUPORTE_PORTAL"
  descricao           String
  prioridade          String                @default("MEDIA") // "BAIXA" | "MEDIA" | "ALTA" | "URGENTE"
  status              String                @default("ABERTO") // "ABERTO" | "EM_ANALISE" | "RESOLVIDO" | "CANCELADO"
  dadosColetadosJson  String?
  acaoRealizadaIa     String?
  proximaProvidencia  String?
  resolvidoPor        String?
  resolvidoEm         DateTime?
  criadoEm            DateTime              @default(now())
}

// ==========================================
// MÓDULO DE MONETIZAÇÃO, PARCEIROS & PATROCINADORES
// ==========================================
model ParceiroPatrocinador {
  id                 String    @id @default(uuid())
  nome               String
  categoria          String    @default("PARCEIRO_OFICIAL") // "EMPREENDIMENTO_ALUNO" | "PATROCINADOR_FELIPE" | "PARCEIRO_OFICIAL" | "APOIADOR_EVENTO"
  descricao          String
  beneficioAlunos    String?
  alunoVinculadoNome String?
  logoUrl            String
  bannerUrl          String?
  linkDestino        String
  tipoLink           String    @default("INSTAGRAM") // "INSTAGRAM" | "WHATSAPP" | "SITE"
  contatoTexto       String?
  destaqueHome       Boolean   @default(true)
  ordem              Int       @default(0)
  dataInicio         DateTime?
  dataFim            DateTime?
  ativo              Boolean   @default(true)
  cliquesCount       Int       @default(0)
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
}

