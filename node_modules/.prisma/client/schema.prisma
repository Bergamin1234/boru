generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Aluno {
  id             String   @id @default(uuid())
  nome           String
  email          String?  @unique
  telefone       String?
  cpf            String?  @unique
  senha          String? // Senha criptografada (ou temporária)
  primeiroAcesso Boolean  @default(true) // Controla se o aluno precisa trocar a senha
  plano          String? // Valores: DIARIA, DUAS_AULAS_SEMANA, TRES_AULAS_SEMANA, TODOS_HORARIOS
  criadoEm       DateTime @default(now())

  mensalidades Mensalidade[]
  presencas    AgendamentoPresenca[]
}

model Mensalidade {
  id             String    @id @default(uuid())
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String    @default("PENDENTE") // Valores: PENDENTE, PAGO, ATRASADO

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  criadoEm DateTime @default(now())
}

model EventoDeAula {
  id         String   @id @default(uuid())
  titulo     String
  dataInicio DateTime
  dataFim    DateTime

  agendamentos AgendamentoPresenca[]

  criadoEm DateTime @default(now())
}

model AgendamentoPresenca {
  id                 String  @id @default(uuid())
  status             String  @default("AGENDADO") // Valores: AGENDADO, PRESENTE, AUSENTE, PENETRA
  fotoComprovanteUrl String? // Para upload da foto como gabarito (se houver)

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id])

  eventoId String
  evento   EventoDeAula @relation(fields: [eventoId], references: [id])

  criadoEm DateTime @default(now())

  @@unique([alunoId, eventoId])
}
